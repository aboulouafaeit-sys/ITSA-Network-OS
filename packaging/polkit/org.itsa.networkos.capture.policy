<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>ITSA Network OS</vendor>
  <vendor_url>https://github.com/itsa-network/itsa-network-os</vendor_url>

  <action id="org.itsa.networkos.capture">
    <description>Run low-level packet capture helper for ITSA Network OS</description>
    <message>Authentication is required to perform low-level packet capture diagnostics.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/itsa-network-os/itsa-priv-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>
</policyconfig>
